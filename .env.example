# API Keys Configuration

# Brevo API Key for email service (used in WhatsApp product waitlist)
# Get your API key from: https://app.brevo.com/settings/keys/api
VITE_BREVO_API_KEY=your_brevo_api_key_here

# Email Configuration
VITE_RECIPIENT_EMAIL=contato@novasyn.com.br
VITE_SENDER_EMAIL=noreply@novasyn.com.br

# Security Configuration
VITE_ENABLE_RATE_LIMIT=true
VITE_MAX_REQUESTS_PER_MINUTE=10
VITE_MAX_REQUESTS_PER_HOUR=50
VITE_ENABLE_HONEYPOT=true

# Cloudflare Configuration
# Get your Zone ID from: Cloudflare Dashboard → Select Domain → Overview → API section
# Get API Token from: Profile → API Tokens → Create Token (Edit Zone DNS template)
CLOUDFLARE_ENABLED=true
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_API_TOKEN=your_api_token_here

# Google Analytics
# Get your Measurement ID from: https://analytics.google.com → Admin → Data Streams
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Production Domain
VITE_SITE_URL=https://novasyn.com.br
